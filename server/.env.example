# llama.cpp runtime. Pin LLAMA_IMAGE to a known tag/digest in production.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_MODELS_DIR=./models
LLAMA_MODEL_FILE=Qwen3.5-2B-UD-Q6_K_XL.gguf
LLAMA_N_GPU_LAYERS=0
LLAMA_CTX_SIZE=8192

# Main conversational model
LLAMA_BASE_URL=http://llama:8080
LLAMA_MODEL=Qwen3.5-2B
LLAMA_TIMEOUT_SECONDS=90

# Canonical dense portfolio retrieval.
EMBEDDING_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=http://embedding:8081
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_CTX_SIZE=4096
EMBEDDING_N_GPU_LAYERS=0

# Portfolio retrieval
KNOWLEDGE_RELEVANCE_THRESHOLD=0.25
CONTEXT_MAX_CHARS=4000
CONTEXT_MAX_DOCUMENTS=4

# Optional local PocketTrace observability
POCKETTRACE_ENABLED=false
POCKETTRACE_URL=http://host.containers.internal:4319
POCKETTRACE_TIMEOUT_SECONDS=1.0

# Free-text response generation
RENDERER_TEMPERATURE=0.65
RENDERER_MAX_TOKENS=180

# Browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-NETLIFY-SITE.example

# Session state (in-memory MVP)
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=8
