# llama.cpp runtime container. Keep the CPU server image by default; override with the
# server image/runtime appropriate for your accelerator when deploying with GPU.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_MODELS_DIR=./models
LLAMA_MODEL_FILE=Qwen3.5-2B-Q4_K_XL.gguf
LLAMA_N_GPU_LAYERS=0

# FastAPI -> llama.cpp
LLAMA_BASE_URL=http://llama:8080
LLAMA_MODEL=Qwen3.5-2B-Q4_K_XL
LLAMA_TIMEOUT_SECONDS=90

# Browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-NETLIFY-SITE.example

# Session state (in-memory MVP)
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=12

# Calendar: mock for local UI work; google for production
CALENDAR_MODE=mock
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=TODO
GOOGLE_CLIENT_SECRET=TODO
GOOGLE_REFRESH_TOKEN=TODO
