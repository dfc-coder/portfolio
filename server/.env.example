PORTFOLIO_PROFILE_PATH=./config/portfolio.json

LLAMA_BASE_URL=http://llama:8080
LLAMA_MODEL=Qwen3.5-4B
LLAMA_MODEL_FILE=Qwen3.5-4B-UD-Q4_K_XL.gguf
LLAMA_MODELS_DIR=./models
LLAMA_TIMEOUT_SECONDS=90

EMBEDDING_BASE_URL=http://embedding:8081
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_TIMEOUT_SECONDS=30

TZ=America/Argentina/Buenos_Aires
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Promptfoo cloud judge. Put the real value only in .env (gitignored).
OPENAI_API_KEY=

# Local eval diagnostics only. Leave empty in deployed environments.
AGENT_DIAGNOSTICS_TOKEN=

GENERATION_TEMPERATURE=0.70
GENERATION_TOP_P=0.80
GENERATION_TOP_K=20
GENERATION_MIN_P=0.0
GENERATION_PRESENCE_PENALTY=1.5
GENERATION_REPEAT_PENALTY=1.0
GENERATION_MAX_TOKENS=256
CONTEXT_MAX_CHARS=4000
CONTEXT_MAX_DOCUMENTS=4
PORTFOLIO_MIN_SCORE=0.10
