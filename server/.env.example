# llama.cpp runtime. Pin LLAMA_IMAGE to a known tag/digest in production.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_MODELS_DIR=./models
LLAMA_MODEL_FILE=Qwen3.5-2B-UD-Q6_K_XL.gguf
LLAMA_N_GPU_LAYERS=0
LLAMA_CTX_SIZE=8192

# Main Qwen 2B model
LLAMA_BASE_URL=http://llama:8080
LLAMA_MODEL=Qwen3.5-2B
LLAMA_TIMEOUT_SECONDS=90

# Qwen3 semantic reranker
RERANKER_MODEL_FILE=qwen3-reranker-0.6b-q8_0.gguf
RERANKER_MODEL=Qwen3-Reranker-0.6B-Q8_0
RERANKER_BASE_URL=http://reranker:8081
RERANKER_TIMEOUT_SECONDS=30
RERANKER_CTX_SIZE=2048
RERANKER_N_GPU_LAYERS=0

# Routing cascade. Reranker resolves clear cases; the LLM judge is deterministic.
ROUTER_MIN_SCORE=0.10
ROUTER_MIN_MARGIN=0.08
ROUTER_JUDGE_TEMPERATURE=0.0
ROUTER_JUDGE_MAX_TOKENS=32

# Dynamic business context. Profile facts are retrieved semantically per turn.
CONTEXT_RELEVANCE_THRESHOLD=0.10
CONTEXT_MAX_CHARS=6000
CONTEXT_MAX_DOCUMENTS=6

# Optional local PocketTrace observability. With Podman Compose, the API reaches
# the host through host.containers.internal. If the API runs directly on the host,
# use http://127.0.0.1:4319 instead.
POCKETTRACE_ENABLED=false
POCKETTRACE_URL=http://host.containers.internal:4319
POCKETTRACE_TIMEOUT_SECONDS=1.0

# Scheduling semantic fallback is deterministic. Free-text business responses stay conversational.
PLANNER_TEMPERATURE=0.0
PLANNER_MAX_TOKENS=64
RENDERER_TEMPERATURE=0.65
RENDERER_MAX_TOKENS=180

# Browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-NETLIFY-SITE.example

# Session state (in-memory MVP)
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=8

# Calendar: mock for local UI work; google for production
CALENDAR_MODE=mock
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=TODO
GOOGLE_CLIENT_SECRET=TODO
GOOGLE_REFRESH_TOKEN=TODO
