# llama.cpp runtime. Pin LLAMA_IMAGE to a known tag/digest in production.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_MODELS_DIR=./models
LLAMA_MODEL_FILE=Qwen3.5-0.8B-UD-Q4_K_XL.gguf
LLAMA_N_GPU_LAYERS=0
LLAMA_CTX_SIZE=4096

# FastAPI -> llama.cpp
LLAMA_BASE_URL=http://llama:8080
LLAMA_MODEL=Qwen3.5-0.8B-UD-Q4_K_XL
LLAMA_TIMEOUT_SECONDS=90

# Bounded Reflective ReAct inference profiles
PLANNER_TEMPERATURE=0.15
PLANNER_MAX_TOKENS=96
RENDERER_TEMPERATURE=0.65
RENDERER_MAX_TOKENS=180
REPAIR_TEMPERATURE=0.10
REPAIR_MAX_TOKENS=96
AGENT_MAX_STEPS=3
AGENT_MAX_REPAIRS=1

# Browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-NETLIFY-SITE.example

# Session state (in-memory MVP)
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=8

# Calendar: mock for local UI work; google for production
CALENDAR_MODE=mock
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=TODO
GOOGLE_CLIENT_SECRET=TODO
GOOGLE_REFRESH_TOKEN=TODO
